    local rainbowHue = 0 local lastESPUpdate = 0
    local function updateESP()
        local now = tick() if now - lastESPUpdate < 1/30 then return end lastESPUpdate = now
        rainbowHue = (rainbowHue + 0.005) % 1 local rainbow = Color3.fromHSV(rainbowHue, 1, 1)
        local camPos = Camera.CFrame.Position local camVPX = Camera.ViewportSize.X local camVPY = Camera.ViewportSize.Y local maxDist = Settings.MaxDistance local espOn = Settings.ESPEnabled local rainbowOn = Settings.RainbowESP local doChams = Settings.Chams local teamCheck = Settings.TeamCheck local myTeam = LocalPlayer.Team

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            local data = getPlayerData(plr) local char, hum, hrp, head = data.char, data.hum, data.hrp, data.head local d = State.ESPDrawings[plr]
            local alive = (hum ~= nil) and (hrp ~= nil) and (head ~= nil) and (hum.Health > 0)
            if alive and teamCheck then local pt = plr.Team if pt and myTeam and pt == myTeam then alive = false end end
            if alive and (hrp.Position - camPos).Magnitude > maxDist then alive = false end
            if not alive then if d then setVisible(d, false) end local chams = State.ChamsHighlights[plr] if chams and chams.Enabled then chams.Enabled = false end continue end
            if doChams then local h = getChams(plr, char) h.Enabled = true local col = rainbowOn and rainbow or Settings.ChamsColor h.FillColor = col h.OutlineColor = col h.FillTransparency = Settings.ChamsTransparency else local chams = State.ChamsHighlights[plr] if chams and chams.Enabled then chams.Enabled = false end end
            if not espOn then if d then setVisible(d, false) end continue end
            if not d then createESP(plr) d = State.ESPDrawings[plr] end
            local hrpPos = hrp.Position local hrpScreen = Camera:WorldToViewportPoint(hrpPos) if hrpScreen.Z <= 0 then setVisible(d, false) continue end
            local headScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) local footScreen = Camera:WorldToViewportPoint(hrpPos - Vector3.new(0, 2.8, 0))
            local top = headScreen.Y if headScreen.Z <= 0 then top = hrpScreen.Y - 40 end local bottom = footScreen.Y if footScreen.Z <= 0 then bottom = hrpScreen.Y + 40 end
            local height = math.abs(bottom - top) local width = height / 2 local bx = hrpScreen.X - width / 2 local by = top local hx = hrpScreen.X
            if height < 3 or width < 2 then setVisible(d, false) continue end
            local color = rainbowOn and rainbow or Settings.BoxColor
            
            if Settings.BoxESP then
                if Settings.BoxStyle == "Kare" then
                    d.Box.Size = Vector2.new(width, height) d.Box.Position = Vector2.new(bx, by) d.Box.Color = color d.Box.Thickness = Settings.BoxThickness d.Box.Visible = true
                    if Settings.BoxFill then d.BoxFill.Size = Vector2.new(width, height) d.BoxFill.Position = Vector2.new(bx, by) d.BoxFill.Color = color d.BoxFill.Transparency = Settings.BoxFillTransparency d.BoxFill.Visible = true else d.BoxFill.Visible = false end
                    for i = 1, 8 do d.Corners[i].Visible = false end
                else
                    d.Box.Visible = false d.BoxFill.Visible = false
                    local len = math.min(width, height) * 0.25
                    local pts = { {bx, by, bx + len, by}, {bx, by, bx, by + len}, {bx + width, by, bx + width - len, by}, {bx + width, by, bx + width, by + len}, {bx, by + height, bx + len, by + height}, {bx, by + height, bx, by + height - len}, {bx + width, by + height, bx + width - len, by + height}, {bx + width, by + height, bx + width, by + height - len} }
                    for i = 1, 8 do local c = d.Corners[i] c.From = Vector2.new(pts[i][1], pts[i][2]) c.To = Vector2.new(pts[i][3], pts[i][4]) c.Color = color c.Thickness = Settings.BoxThickness + 1 c.Visible = true end
                end
            else d.Box.Visible = false d.BoxFill.Visible = false for i = 1, 8 do d.Corners[i].Visible = false end end

            if Settings.LineESP then local origin if Settings.LineOrigin == "Alt" then origin = Vector2.new(camVPX / 2, camVPY - 5) else origin = Vector2.new(camVPX / 2, camVPY / 2) end d.Line.From = origin d.Line.To = Vector2.new(hx, hrpScreen.Y) d.Line.Color = rainbowOn and rainbow or Settings.LineColor d.Line.Thickness = Settings.LineThickness d.Line.Visible = true else d.Line.Visible = false end
            
            if Settings.NameESP then d.Name.Text = plr.Name d.Name.Position = Vector2.new(hx, by - 18) d.Name.Size = Settings.NameSize d.Name.Color = rainbowOn and rainbow or Settings.NameColor d.Name.Visible = true else d.Name.Visible = false end
            
            if Settings.HealthESP then
                local hp = hum.Health / hum.MaxHealth local hcol = getHealthColor(hp)
                if Settings.HealthBar then d.HealthBarOutline.Size = Vector2.new(4, height + 2) d.HealthBarOutline.Position = Vector2.new(bx - 8, by - 1) d.HealthBarOutline.Visible = true d.HealthBar.Size = Vector2.new(2, height * hp) d.HealthBar.Position = Vector2.new(bx - 7, by + height * (1 - hp)) d.HealthBar.Color = hcol d.HealthBar.Visible = true else d.HealthBar.Visible = false d.HealthBarOutline.Visible = false end
                if Settings.HealthText then d.HealthText.Text = math.floor(hum.Health) .. " HP" d.HealthText.Position = Vector2.new(hx, by + height + 3) d.HealthText.Color = hcol d.HealthText.Visible = true else d.HealthText.Visible = false end
            else d.HealthBar.Visible = false d.HealthBarOutline.Visible = false d.HealthText.Visible = false end
            
            if Settings.DistanceESP then d.Distance.Text = "[" .. math.floor((hrpPos - camPos).Magnitude) .. " stud]" d.Distance.Position = Vector2.new(hx, by - 32) d.Distance.Color = rainbowOn and rainbow or Settings.DistanceColor d.Distance.Visible = true else d.Distance.Visible = false end
            
            if Settings.SkeletonESP then
                local bones = data.isR15 and SKELETON_BONES_R15 or SKELETON_BONES_R6
                local maxBones = Settings.SkeletonMode == "Simple" and 5 or #bones
                local scolor = rainbowOn and rainbow or Settings.SkeletonColor local sthick = Settings.SkeletonThickness
                for i = 1, 14 do
                    if i <= maxBones and bones[i] then
                        local fromPart = char:FindFirstChild(bones[i][1]) local toPart = char:FindFirstChild(bones[i][2])
                        if fromPart and toPart then
                            local fp = Camera:WorldToViewportPoint(fromPart.Position) local tp = Camera:WorldToViewportPoint(toPart.Position)
                            if fp.Z > 0 and tp.Z > 0 then local line = d.Skeleton[i] line.From = Vector2.new(fp.X, fp.Y) line.To = Vector2.new(tp.X, tp.Y) line.Color = scolor line.Thickness = sthick line.Visible = true else d.Skeleton[i].Visible = false end
                        else d.Skeleton[i].Visible = false end
                    else d.Skeleton[i].Visible = false end
                end
            else for i = 1, 14 do d.Skeleton[i].Visible = false end end
        end
    end

    local function findAimbotTarget()
        local mpos = UIS:GetMouseLocation() local best, bestScore = nil, math.huge local camPos = Camera.CFrame.Position local fov = Settings.AimbotFOV local byFOV = Settings.AimbotPriority == "FOV"
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end if isAimbotAlly(plr) then continue end
            local char = plr.Character if not char then continue end local hum = char:FindFirstChildOfClass("Humanoid") if not hum or hum.Health <= 0 then continue end local hrp = char:FindFirstChild("HumanoidRootPart") if not hrp then continue end
            local dist = (hrp.Position - camPos).Magnitude if dist > Settings.AimbotMaxDistance then continue end
            local part = getHitboxPart(char, Settings.AimbotHitbox) if not part then continue end if not isVisible(part, char) then continue end
            local screenPos = Camera:WorldToViewportPoint(part.Position) local score
            if byFOV then score = (Vector2.new(screenPos.X, screenPos.Y) - mpos).Magnitude if score > fov then continue end else score = dist end
            if score < bestScore then bestScore = score best = {part = part, char = char, hum = hum, plr = plr} end
        end
        return best
    end

    local function isAimbotActive()
        if not Settings.AimbotEnabled then return false end if not Settings.AimbotHold then return true end local key = Settings.AimbotKey
        if typeof(key) == "EnumItem" then if key.EnumType == Enum.KeyCode then return UIS:IsKeyDown(key) elseif key.EnumType == Enum.UserInputType then return UIS:IsMouseButtonPressed(key) end end
        return false
    end

    local function aimStep()
        if not isAimbotActive() then State.LockedTarget = nil State.LockTime = 0 return end
        local target
        if Settings.AimbotLockTarget and State.LockedTarget and (tick() - State.LockTime) < Settings.AimbotLockTime then
            local locked = State.LockedTarget local char = locked.char local hum = char and char:FindFirstChildOfClass("Humanoid") local part = char and char:FindFirstChild(locked.partName)
            if hum and hum.Health > 0 and part and isVisible(part, char) then target = {part = part, char = char, hum = hum, plr = locked.plr} else State.LockedTarget = nil end
        end
        if not target then target = findAimbotTarget() if target and Settings.AimbotLockTarget then State.LockedTarget = {char = target.char, partName = target.part.Name, plr = target.plr} State.LockTime = tick() end end
        if not target then return end
        local aimPos = target.part.Position
        if Settings.AimbotPrediction and target.part.AssemblyLinearVelocity then local predAmt = Settings.AimbotPredictionAmount if Settings.JumpAccuracy and State.IsJumping then predAmt = predAmt * Settings.JumpPredictionBoost end aimPos = aimPos + target.part.AssemblyLinearVelocity * predAmt end
        local camPos = Camera.CFrame.Position
        if Settings.AimbotMode == "Snap" then Camera.CFrame = CFrame.new(camPos, aimPos) elseif Settings.AimbotMode == "Smooth" then local smooth = math.clamp(1 - (Settings.AimbotSmoothness / 100), 0.02, 1) Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(camPos, aimPos), smooth) elseif Settings.AimbotMode == "Silent" then Camera.CFrame = CFrame.new(camPos, aimPos) end
    end

    local function findSilentTarget()
        local best, bestScore = nil, math.huge local camPos = Camera.CFrame.Position local fov = Settings.SilentAimFOV
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end if Settings.SilentAimTeamCheck and isAlly(plr) then continue end
            local char = plr.Character if not char then continue end local hum = char:FindFirstChildOfClass("Humanoid") if not hum or hum.Health <= 0 then continue end local hrp = char:FindFirstChild("HumanoidRootPart") if not hrp then continue end
            local dist = (hrp.Position - camPos).Magnitude if dist > Settings.SilentAimMaxDistance then continue end
            local part = getHitboxPart(char, Settings.SilentAimHitbox) if not part then continue end
            if Settings.SilentAimWallCheck then if not isVisible(part, char) then continue end end
            if Settings.SilentAimVisibleOnly then if not isVisible(part, char) then continue end end
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            local screenDist = onScreen and (Vector2.new(screenPos.X, screenPos.Y) - UIS:GetMouseLocation()).Magnitude or math.huge
            local score = math.min(dist, screenDist) if screenDist > fov and dist > Settings.SilentAimMaxDistance then continue end
            if score < bestScore then bestScore = score best = {part = part, char = char, hum = hum, plr = plr} end
        end
        return best
    end

    UIS.InputBegan:Connect(function(input, gp) if gp then return end local key = Settings.SilentAimKey if typeof(key) == "EnumItem" then if (key.EnumType == Enum.UserInputType and input.UserInputType == key) or (key.EnumType == Enum.KeyCode and input.KeyCode == key) then State.SilentFiring = true end end end)
    UIS.InputEnded:Connect(function(input) local key = Settings.SilentAimKey if typeof(key) == "EnumItem" then if (key.EnumType == Enum.UserInputType and input.UserInputType == key) or (key.EnumType == Enum.KeyCode and input.KeyCode == key) then State.SilentFiring = false end end end)

    RunService.RenderStepped:Connect(function() if not Settings.SilentAimEnabled then State.SilentTarget = nil return end if State.SilentFiring then State.SilentTarget = findSilentTarget() else State.SilentTarget = nil end end)

    task.spawn(function() while true do task.wait(60) if Settings.AntiAFK then pcall(function() VirtualUser:CaptureController() VirtualUser:ClickButton2(Vector2.new()) end) end end end)

    task.spawn(function() while task.wait(0.5) do if not Settings.AntiFling then continue end local char = LocalPlayer.Character if not char then continue end local hrp = char:FindFirstChild("HumanoidRootPart") if not hrp then continue end
        for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then local isBodyPart = part.Name == "Head" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name:find("Arm") or part.Name:find("Leg") or part.Name:find("Hand") or part.Name:find("Foot") if not isBodyPart and part.Massless ~= true then pcall(function() part:Destroy() end) end end end
        local vel = hrp.AssemblyLinearVelocity if vel.Magnitude > 500 then hrp.AssemblyLinearVelocity = Vector3.zero hrp.AssemblyAngularVelocity = Vector3.zero end
        for _, part in ipairs(char:GetDescendants()) do if part:IsA("BodyVelocity") or part:IsA("BodyAngularVelocity") or part:IsA("BodyForce") or part:IsA("BodyGyro") then if not (part:IsA("BodyVelocity") and Settings.FlyEnabled) and not (part:IsA("BodyGyro") and Settings.FlyEnabled) then pcall(function() part:Destroy() end) end end end
    end end)

    task.spawn(function() while task.wait(0.3) do if not Settings.AntiVoid then continue end if tick() - State.VoidCooldown < 1 then continue end local char = LocalPlayer.Character if not char then continue end local hrp = char:FindFirstChild("HumanoidRootPart") if not hrp then continue end if hrp.Position.Y < Settings.AntiVoidY then pcall(function() local spawn = workspace:FindFirstChildOfClass("SpawnLocation") if spawn then hrp.CFrame = spawn.CFrame + Vector3.new(0, 3, 0) else hrp.CFrame = CFrame.new(0, 50, 0) end end) State.VoidCooldown = tick() end end end)

    local fovCircle = Drawing.new("Circle") fovCircle.Thickness = 1.5 fovCircle.NumSides = 96 fovCircle.Visible = false
    local function updateFOV() if not Settings.FOVCircle or not Settings.AimbotEnabled then if fovCircle.Visible then fovCircle.Visible = false end return end local mpos = UIS:GetMouseLocation() fovCircle.Position = Vector2.new(mpos.X, mpos.Y) fovCircle.Radius = Settings.AimbotFOV fovCircle.Color = Settings.FOVCircleColor fovCircle.Filled = Settings.FOVCircleFilled fovCircle.Transparency = Settings.FOVCircleTransparency fovCircle.Visible = true end

    local function bunnyHop() if not Settings.BunnyHop then return end local char = LocalPlayer.Character if not char then return end local hum = char:FindFirstChildOfClass("Humanoid") if not hum or hum.Health <= 0 then return end if Settings.BhopMode == "Basılı" and not UIS:IsKeyDown(Enum.KeyCode.Space) then return end if hum.MoveDirection.Magnitude > 0 then hum.Jump = true end end

    local flyBodyVel, flyBodyGyro
    local function updateFly()
        local char = LocalPlayer.Character if not char then if flyBodyVel then flyBodyVel:Destroy() flyBodyVel = nil end if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end return end local hrp = char:FindFirstChild("HumanoidRootPart") if not hrp then return end
        if Settings.FlyEnabled then
            if not flyBodyVel or not flyBodyVel.Parent then flyBodyVel = Instance.new("BodyVelocity") flyBodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge) flyBodyVel.Velocity = Vector3.zero flyBodyVel.Parent = hrp end
            if not flyBodyGyro or not flyBodyGyro.Parent then flyBodyGyro = Instance.new("BodyGyro") flyBodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge) flyBodyGyro.P = 1000 flyBodyGyro.D = 50 flyBodyGyro.CFrame = hrp.CFrame flyBodyGyro.Parent = hrp end
            local move = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then move += Camera.CFrame.LookVector end if UIS:IsKeyDown(Enum.KeyCode.S) then move -= Camera.CFrame.LookVector end if UIS:IsKeyDown(Enum.KeyCode.A) then move -= Camera.CFrame.RightVector end if UIS:IsKeyDown(Enum.KeyCode.D) then move += Camera.CFrame.RightVector end if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then move -= Vector3.new(0, 1, 0) end
            flyBodyVel.Velocity = move.Magnitude > 0 and (move.Unit * Settings.FlySpeed) or Vector3.zero
            flyBodyGyro.CFrame = Camera.CFrame
        else if flyBodyVel then flyBodyVel:Destroy() flyBodyVel = nil end if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end end
    end

    local function applyNoClip() if not Settings.NoClip then return end local char = LocalPlayer.Character if not char then return end for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") and part.CanCollide then part.CanCollide = false end end end

    local function bindDeath(plr, char) local hum = char:WaitForChild("Humanoid", 5) if not hum then return end hum.Died:Connect(function() local d = State.ESPDrawings[plr] if d then setVisible(d, false) end local chams = State.ChamsHighlights[plr] if chams then chams.Enabled = false end end) end
    local function setupPlayer(plr) if plr == LocalPlayer then return end if plr.Character then bindDeath(plr, plr.Character) end plr.CharacterAdded:Connect(function(c) State.PlayerCache[plr] = nil local d = State.ESPDrawings[plr] if d then setVisible(d, false) end bindDeath(plr, c) end) plr.CharacterRemoving:Connect(function() State.PlayerCache[plr] = nil local d = State.ESPDrawings[plr] if d then setVisible(d, false) end local chams = State.ChamsHighlights[plr] if chams then chams.Enabled = false end end) end
    for _, plr in ipairs(Players:GetPlayers()) do setupPlayer(plr) end Players.PlayerAdded:Connect(setupPlayer) Players.PlayerRemoving:Connect(function(plr) clearESP(plr) State.PlayerCache[plr] = nil end)

    task.spawn(function() while task.wait() do if not Settings.ESPEnabled and not Settings.Chams then task.wait(0.2) else updateESP() end end end)
    task.spawn(function() while task.wait(1/30) do updateFOV() end end)
    RunService:BindToRenderStep("CB_Aim", Enum.RenderPriority.Camera.Value + 1, function() aimStep() end)
    RunService.Heartbeat:Connect(function() bunnyHop() updateFly() applyNoClip() end)

    UIS.InputBegan:Connect(function(input, gp) if input.KeyCode == Enum.KeyCode.Delete and not gp then Settings.MenuOpen = not Settings.MenuOpen Main.Visible = Settings.MenuOpen ToggleBtn.Visible = not Settings.MenuOpen elseif input.KeyCode == Enum.KeyCode.End then Main.Visible = false Settings.MenuOpen = false ToggleBtn.Visible = true end end)
end

