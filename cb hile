    local function zeroOutSpread()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            for _, child in ipairs(hum:GetChildren()) do
                if child:IsA("NumberValue") or child:IsA("IntValue") then
                    local n = child.Name:lower()
                    if n:find("spread") or n:find("recoil") or n:find("bloom") or n:find("shake") then
                        pcall(function() child.Value = 0 end)
                    end
                end
            end
        end
        for _, child in ipairs(LocalPlayer:GetChildren()) do
            if child:IsA("NumberValue") or child:IsA("IntValue") then
                local n = child.Name:lower()
                if n:find("spread") or n:find("recoil") or n:find("bloom") then
                    pcall(function() child.Value = 0 end)
                end
            end
        end
        pcall(function()
            for _, parent in ipairs({ReplicatedStorage, workspace}) do
                for _, child in ipairs(parent:GetChildren()) do
                    if child:IsA("NumberValue") then
                        local n = child.Name:lower()
                        if n:find("spread") or n:find("recoil") then child.Value = 0 end
                    end
                end
            end
        end)
        if Settings.NoCameraShake then
            pcall(function()
                for _, c in ipairs(Camera:GetChildren()) do
                    if (c:IsA("Script") or c:IsA("LocalScript")) then
                        local n = c.Name:lower()
                        if n:find("shake") or n:find("recoil") then c.Disabled = true end
                    end
                end
            end)
        end
    end

