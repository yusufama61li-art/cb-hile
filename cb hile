local function GetCurrentSecretKey()
    local timeBlock = math.floor(os.time() / 240)
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local key = "HUSH-"
    for i = 0, 5 do
        local index = ((timeBlock + (i * 7)) % 36) + 1
        key = key .. string.sub(chars, index, index)
    end
    return key
end

