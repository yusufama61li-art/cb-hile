    local function setupSilentAimHook()
        if State.SilentHooked then return end
        if not hookmetamethod then return end
        local ok, err = pcall(function()
            local mt = getrawmetatable(game)
            if not mt then error("getrawmetatable nil") end
            local oldIndex = mt.__index
            setreadonly(mt, false)
            mt.__index = newcclosure(function(self, key)
                if State.SilentFiring and State.SilentTarget and Settings.SilentAimEnabled then
                    local tgt = State.SilentTarget
                    local part = tgt.part
                    if part and part.Parent then
                        if (self == Camera or self == workspace.CurrentCamera) and key == "CFrame" then
                            local realCF = oldIndex(self, key)
                            local aimPos = part.Position
                            if Settings.SilentAimPrediction and part.AssemblyLinearVelocity then
                                local predAmt = Settings.SilentAimPredictionAmount
                                if Settings.JumpAccuracy and State.IsJumping then
                                    predAmt = predAmt * Settings.JumpPredictionBoost
                                end
                                aimPos = aimPos + part.AssemblyLinearVelocity * predAmt
                            end
                            return CFrame.new(realCF.Position, aimPos)
                        end
                    end
                end
                return oldIndex(self, key)
            end)
            setreadonly(mt, true)
            SilentAimOK = true
            State.SilentHooked = true
        end)
    end

    local function setupAntiKickHook()
        if State.AntiKickHooked then return end
        if not hookmetamethod then return end
        local ok, err = pcall(function()
            local mt = getrawmetatable(game)
            if not mt then error("getrawmetatable nil") end
            local oldNamecall = mt.__namecall
            setreadonly(mt, false)
            mt.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod()
                if Settings.AntiKick then
                    if method == "Kick" and (self == LocalPlayer or self == game) then
                        State.BlockedKicks = State.BlockedKicks + 1
                        return nil
                    end
                end
                return oldNamecall(self, ...)
            end)
            setreadonly(mt, true)
            State.AntiKickHooked = true
        end)
    end

